{
    "name": "rolland97/filament-resource-customizer",
    "description": "Customize Filament resources with optional Filament Shield permissions scaffolding.",
    "keywords": [
        "Rolland97",
        "laravel",
        "filament",
        "permissions",
        "generator",
        "filament-resource-customizer"
    ],
    "homepage": "https://github.com/rolland97/filament-resource-customizer",
    "license": "MIT",
    "authors": [
        {
            "name": "Rolland",
            "email": "rollandson26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.5.0",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Rolland\\FilamentResourceCustomizer\\": "src/",
            "Rolland\\FilamentResourceCustomizer\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rolland\\FilamentResourceCustomizer\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rolland\\FilamentResourceCustomizer\\FilamentResourceCustomizerServiceProvider"
            ],
            "aliases": {
                "FilamentResourceCustomizer": "Rolland\\FilamentResourceCustomizer\\Facades\\FilamentResourceCustomizer"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
